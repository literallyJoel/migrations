{
  "name": "@literallyjoel/migrations",
  "version": "1.1.3",
  "description": "Universal SQL migration utility for Bun & Node",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "migrate": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "bun run ./src/cli.ts",
    "test": "bun test",
    "debug:ui": "bun run ./src/debugUi.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.0.0",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.2.3"
  }
}
